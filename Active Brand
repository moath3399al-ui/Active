<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Active | أكتيڤ</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">

<style>
:root {
  --black:#0a0a0a; --white:#f5f5f5; --gray:#777;
  --teal:#00c9b1; --teal-dim:rgba(0,201,177,.15);
  --surface:#111; --border:#1e1e1e;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--black);color:var(--white);font-family:'Cairo',sans-serif;overflow-x:hidden;}

/* HERO */
#hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden;text-align:center;padding:40px 24px;}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff09 1px,transparent 1px),linear-gradient(90deg,#ffffff09 1px,transparent 1px);background-size:50px 50px;animation:gridDrift 25s linear infinite;}
@keyframes gridDrift{to{background-position:50px 50px;}}
.hero-glow{position:absolute;width:500px;height:500px;background:radial-gradient(circle,rgba(0,201,177,.18) 0%,transparent 70%);border-radius:50%;animation:pulse 5s ease-in-out infinite;}
@keyframes pulse{0%,100%{transform:scale(1);opacity:.6;}50%{transform:scale(1.3);opacity:1;}}
.hero-content{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:20px;}
.hero-logo{width:150px;height:150px;object-fit:cover;filter:drop-shadow(0 0 40px rgba(0,201,177,.5));animation:float 6s ease-in-out infinite,fadeUp .8s ease forwards;opacity:0;}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-14px);}}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px);}to{opacity:1;transform:translateY(0);}}
.hero-name{font-family:'Bebas Neue',sans-serif;font-size:clamp(80px,20vw,180px);letter-spacing:.12em;line-height:.85;background:linear-gradient(135deg,#fff 40%,var(--teal));-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:fadeUp .9s .15s ease both;}
.hero-tagline{font-size:13px;letter-spacing:.45em;text-transform:uppercase;color:var(--gray);animation:fadeUp .9s .3s ease both;}
.scroll-hint{position:absolute;bottom:36px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;z-index:2;animation:fadeIn 1.5s 1.2s both;}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
.scroll-hint span{font-size:10px;letter-spacing:.35em;color:var(--gray);text-transform:uppercase;}
.scroll-line{width:1px;height:50px;background:linear-gradient(to bottom,var(--teal),transparent);animation:linePulse 2s ease infinite;}
@keyframes linePulse{0%,100%{opacity:.3;}50%{opacity:1;}}

/* ABOUT */
#about{padding:100px 24px;max-width:860px;margin:0 auto;}
.sec-tag{font-size:10px;letter-spacing:.5em;color:var(--teal);text-transform:uppercase;display:block;margin-bottom:16px;}
.sec-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(56px,12vw,110px);line-height:.88;margin-bottom:40px;}
.about-para{font-size:17px;line-height:2.1;color:#bbb;font-weight:300;border-right:3px solid var(--teal);padding-right:20px;margin-bottom:48px;}
.about-para strong{color:#fff;font-weight:700;}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);}
.stat{background:var(--surface);padding:32px 20px;text-align:center;}
.stat-n{font-family:'Bebas Neue',sans-serif;font-size:48px;display:block;line-height:1;}
.stat-l{font-size:11px;color:var(--gray);letter-spacing:.2em;text-transform:uppercase;margin-top:6px;display:block;}
.quality-box{margin-top:48px;border:1px solid var(--border);background:var(--surface);padding:28px;display:flex;align-items:center;gap:20px;position:relative;overflow:hidden;}
.quality-box::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--teal);}
.q-icon{font-size:40px;flex-shrink:0;}
.q-text h3{font-family:'Bebas Neue',sans-serif;font-size:26px;margin-bottom:6px;}
.q-text p{color:var(--gray);font-size:13px;line-height:1.7;}

/* PRODUCTS */
#products{padding:80px 0 100px;background:var(--surface);overflow:hidden;}
.prod-header{padding:0 24px;max-width:860px;margin:0 auto 48px;}
.slider-wrap{position:relative;overflow:hidden;touch-action:pan-y;}
.slider-track{display:flex;transition:transform .55s cubic-bezier(.25,.46,.45,.94);}
.slide{min-width:100vw;padding:0 16px 32px;display:flex;flex-direction:column;align-items:center;gap:24px;}

/* outfit card */
.outfit-card{width:100%;max-width:460px;background:var(--black);border:1px solid var(--border);position:relative;overflow:hidden;}
.outfit-img{width:100%;display:block;object-fit:cover;}
.color-tag{position:absolute;top:14px;right:14px;background:rgba(0,0,0,.85);border:1px solid var(--border);padding:5px 14px;font-size:11px;letter-spacing:.3em;color:var(--teal);text-transform:uppercase;}
.outfit-info{padding:20px 20px 24px;border-top:1px solid var(--border);}
.outfit-nm{font-family:'Bebas Neue',sans-serif;font-size:30px;letter-spacing:.05em;margin-bottom:4px;}
.outfit-price{font-size:20px;color:var(--teal);font-weight:700;margin-bottom:14px;}
.sizes{display:flex;gap:6px;flex-wrap:wrap;}
.sz{border:1px solid var(--border);padding:5px 12px;font-size:12px;color:var(--gray);background:transparent;cursor:pointer;font-family:'Cairo',sans-serif;transition:all .2s;}
.sz:hover,.sz.on{border-color:var(--teal);color:var(--teal);}

/* detail grid — 2 cards only now */
.det-grid{width:100%;max-width:460px;display:grid;grid-template-columns:1fr 1fr;gap:2px;background:var(--border);}
.det-card{background:#0d0d0d;padding:16px;display:flex;flex-direction:column;gap:8px;}
.det-tag{font-size:10px;letter-spacing:.3em;color:var(--teal);text-transform:uppercase;}
.det-img{width:100%;aspect-ratio:1/1;object-fit:contain;background:#111;padding:12px;display:block;}
.det-title{font-size:12px;font-weight:700;color:var(--white);line-height:1.4;}
.det-copy{font-size:11px;color:var(--gray);font-style:italic;line-height:1.5;border-right:2px solid var(--teal);padding-right:6px;}

/* shoulder detail — black only, full width */
.det-card.full{grid-column:1/-1;}
.det-img-wide{width:100%;aspect-ratio:16/6;object-fit:cover;object-position:top center;display:block;}

/* info table */
.info-table{width:100%;max-width:460px;background:#0d0d0d;border:1px solid var(--border);padding:20px;}
.info-table table{width:100%;border-collapse:collapse;}
.info-table td{padding:9px 0;font-size:13px;border-bottom:1px solid #1a1a1a;}
.info-table td:first-child{color:var(--gray);}
.info-table td:last-child{text-align:left;}
.price-cell{font-size:20px;color:var(--teal);font-weight:700;border-bottom:none!important;}

/* controls */
.ctrl{display:flex;align-items:center;justify-content:center;gap:20px;margin-top:40px;padding:0 24px;}
.ctrl-btn{width:46px;height:46px;border:1px solid var(--border);background:transparent;color:var(--white);font-size:18px;cursor:pointer;transition:all .25s;display:flex;align-items:center;justify-content:center;}
.ctrl-btn:hover{border-color:var(--teal);color:var(--teal);box-shadow:0 0 18px var(--teal-dim);}
.dots{display:flex;gap:7px;}
.dot{width:6px;height:6px;border-radius:50%;background:var(--border);cursor:pointer;transition:all .3s;}
.dot.on{background:var(--teal);width:22px;border-radius:3px;}

/* SOCIAL */
#social{padding:90px 24px;max-width:860px;margin:0 auto;text-align:center;}
.soc-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:40px 0 48px;}
@media(max-width:480px){.soc-cards{grid-template-columns:1fr;}.stats{grid-template-columns:1fr;}}
.soc-card{background:var(--surface);border:1px solid var(--border);padding:28px 20px;text-decoration:none;color:var(--white);display:flex;flex-direction:column;align-items:center;gap:10px;position:relative;overflow:hidden;transition:border-color .3s;}
.soc-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--teal);transform:scaleX(0);transition:transform .4s;}
.soc-card:hover{border-color:rgba(0,201,177,.3);}
.soc-card:hover::after{transform:scaleX(1);}
.soc-icon{font-size:32px;}
.soc-platform{font-size:10px;letter-spacing:.4em;color:var(--teal);text-transform:uppercase;}
.soc-name{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:.04em;}
.soc-handle{font-size:13px;color:var(--gray);}
.qr-box{border:1px solid var(--border);background:var(--surface);padding:36px 24px;display:flex;flex-direction:column;align-items:center;gap:16px;}
#qrcode{padding:14px;background:#fff;display:inline-block;}
footer{border-top:1px solid var(--border);padding:28px 24px;text-align:center;color:var(--gray);font-size:12px;}
.rv{opacity:0;transform:translateY(28px);transition:opacity .8s,transform .8s;}
.rv.show{opacity:1;transform:none;}
</style>
</head>
